 /* wallust template - colors-rofi */

* {
active-background: #D3D6CB;
active-foreground: #F5F5F2;
normal-background: #000000;
normal-foreground: #F5F5F2;
urgent-background: #E1E0D8;
urgent-foreground: #F5F5F2;

alternate-active-background: #CDD1C6;
alternate-active-foreground: #F5F5F2;
alternate-normal-background: #000000;
alternate-normal-foreground: #F5F5F2;
alternate-urgent-background: #000000;
alternate-urgent-foreground: #F5F5F2;

selected-active-background: #E1E0D8;
selected-active-foreground: #F5F5F2;
selected-normal-background: #E1E0D8;
selected-normal-foreground: #F5F5F2;
selected-urgent-background: #E1E0D8;
selected-urgent-foreground: #F5F5F2;

background-color: #000000;
background: rgba(0,0,0,0.7);
foreground: #F5F5F2;
border-color: #D3D6CB;

color0: #000000;
color1: #666861;
color2: #797A73;
color3: #9A9D95;
color4: #9EA098;
color5: #A9A8A2;
color6: #AAAAA4;
color7: #E8E8E5;
color8: #A3A2A0;
color9: #888A82;
color10: #A2A39A;
color11: #CDD1C6;
color12: #D3D6CB;
color13: #E1E0D8;
color14: #E2E2DB;
color15: #E8E8E5;


}

