 /* wallust template - colors-rofi */

* {
active-background: #D0D2CD;
active-foreground: #F6F5F2;
normal-background: #151412;
normal-foreground: #F6F5F2;
urgent-background: #CEDBD6;
urgent-foreground: #F6F5F2;

alternate-active-background: #9B9889;
alternate-active-foreground: #F6F5F2;
alternate-normal-background: #151412;
alternate-normal-foreground: #F6F5F2;
alternate-urgent-background: #151412;
alternate-urgent-foreground: #F6F5F2;

selected-active-background: #CEDBD6;
selected-active-foreground: #F6F5F2;
selected-normal-background: #CEDBD6;
selected-normal-foreground: #F6F5F2;
selected-urgent-background: #CEDBD6;
