 /* wallust template - colors-rofi */

* {
active-background: #DD7151;
active-foreground: #FDF3D5;
normal-background: #141112;
normal-foreground: #FDF3D5;
urgent-background: #AB8895;
urgent-foreground: #FDF3D5;

alternate-active-background: #B95F45;
alternate-active-foreground: #FDF3D5;
alternate-normal-background: #141112;
alternate-normal-foreground: #FDF3D5;
alternate-urgent-background: #141112;
alternate-urgent-foreground: #FDF3D5;

selected-active-background: #AB8895;
selected-active-foreground: #FDF3D5;
selected-normal-background: #AB8895;
selected-normal-foreground: #FDF3D5;
selected-urgent-background: #DD7151;
selected-urgent-foreground: #FDF3D5;

background-color: #141112;
background: rgba(0,0,0,0.7);
foreground: #FDF3D5;
border-color: #DD7151;

color0: #3C393A;
color1: #542B22;
color2: #5D2E2C;
color3: #8A4734;
color4: #A6553D;
color5: #806670;
color6: #BCA665;
color7: #F4E6BB;
color8: #ABA183;
color9: #6F3A2E;
color10: #7C3D3B;
color11: #B95F45;
color12: #DD7151;
color13: #AB8895;
color14: #FADE87;
color15: #F4E6BB;


}

