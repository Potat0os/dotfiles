 /* wallust template - colors-rofi */

* {
active-background: #555656;
active-foreground: #D6D6D6;
normal-background: #121212;
normal-foreground: #D6D6D6;
urgent-background: #898B8B;
urgent-foreground: #D6D6D6;

alternate-active-background: #505050;
alternate-active-foreground: #D6D6D6;
alternate-normal-background: #121212;
alternate-normal-foreground: #D6D6D6;
alternate-urgent-background: #121212;
alternate-urgent-foreground: #D6D6D6;

selected-active-background: #555656;
selected-active-foreground: #121212;
selected-normal-background: #555656;
selected-normal-foreground: #121212;
selected-urgent-background: #505050;
selected-urgent-foreground: #121212;

background-color: #121212;
background: rgba(0,0,0,0.7);
foreground: #D6D6D6;
border-color: #555656;

color0: #3A3A3A;
color1: #0D0D0E;
color2: #131314;
color3: #3C3C3C;
color4: #404041;
color5: #676868;
color6: #676868;
color7: #BCBDBD;
color8: #838484;
color9: #121213;
color10: #19191A;
color11: #505050;
color12: #555656;
color13: #898B8B;
color14: #898B8B;
color15: #BCBDBD;


}

