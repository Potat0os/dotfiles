 /* wallust template - colors-rofi */

* {
active-background: #818283;
active-foreground: #EEEFEF;
normal-background: #000000;
normal-foreground: #EEEFEF;
urgent-background: #BBBDBD;
urgent-foreground: #EEEFEF;

alternate-active-background: #7A7C7C;
alternate-active-foreground: #EEEFEF;
alternate-normal-background: #000000;
alternate-normal-foreground: #EEEFEF;
alternate-urgent-background: #000000;
alternate-urgent-foreground: #EEEFEF;

selected-active-background: #818283;
selected-active-foreground: #000000;
selected-normal-background: #818283;
selected-normal-foreground: #000000;
selected-urgent-background: #7A7C7C;
selected-urgent-foreground: #000000;

background-color: #000000;
background: rgba(0,0,0,0.7);
foreground: #EEEFEF;
border-color: #818283;

color0: #000000;
color1: #2B2B2C;
color2: #323233;
color3: #5C5D5D;
color4: #616262;
color5: #8D8E8E;
color6: #9B9C9C;
color7: #DEDFDF;
color8: #9B9C9C;
color9: #393A3A;
color10: #434344;
color11: #7A7C7C;
color12: #818283;
color13: #BBBDBD;
color14: #CED0D0;
color15: #DEDFDF;


}

